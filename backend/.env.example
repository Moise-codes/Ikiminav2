# Copy to .env and fill in real values before running locally or deploying.
# Never commit real secrets to version control.

ENVIRONMENT=local
DEBUG=1
APP_NAME=Ikimina API
API_PREFIX=/api/v1
TIMEZONE=Africa/Kigali

DATABASE_URL=postgresql+asyncpg://ikimina:ikimina@localhost:5432/ikimina
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=0

REDIS_URL=redis://localhost:6379/0

# Production secrets — never commit real values.
SECRET_KEY=change-me-to-a-32-plus-character-random-string
JWT_SECRET=change-me-to-a-32-plus-character-random-string
OTP_HMAC_SECRET=change-me-to-a-32-plus-character-random-string

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_DAILY_CAP_PER_PHONE=10
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

SMS_PROVIDER=fake
SMS_SENDER_ID=IKIMINA
SMS_API_KEY=
SMS_API_SECRET=
SMS_BASE_URL=
SMS_TIMEOUT_SECONDS=15

# --- mtn mobile money (optional; required to send/receive real money) ---
MTN_ENVIRONMENT=sandbox
MTN_COLLECTION_BASE_URL=https://sandbox.momodeveloper.mtn.com/collection
MTN_DISBURSEMENT_BASE_URL=https://sandbox.momodeveloper.mtn.com/disbursement
MTN_COLLECTION_API_USER=
MTN_COLLECTION_API_KEY=
MTN_DISBURSEMENT_API_USER=
MTN_DISBURSEMENT_API_KEY=
MTN_WEBHOOK_SECRET=
MTN_CALLBACK_BASE_URL=http://localhost:8000

EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@ikimina.rw
PUBLIC_BASE_URL=http://localhost:8000

ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_ENABLED=1
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_OTP_PER_MINUTE=5

LOG_LEVEL=INFO
LOG_JSON=1
SENTRY_DSN=

PRIVACY_NOTICE_VERSION=2026-11-14

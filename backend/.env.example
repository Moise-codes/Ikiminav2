# =============================================================================
# Itsinda Platform v2 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values before running locally or
# deploying to production.
#
# NEVER commit a .env file with real secrets to version control.
# Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.) in prod.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=local                        # local | test | ci | staging | production
DEBUG=1                                  # 0 in production
APP_NAME=Itsinda API
API_PREFIX=/api/v1
TIMEZONE=Africa/Kigali

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://itsinda:itsinda@localhost:5432/itsinda
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_ECHO=0                                # 1 to log every SQL statement (dev only)

# -----------------------------------------------------------------------------
# Redis 7
# Used for: rate limiting, OTP budget, access-token blacklist
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Security secrets
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# All three must be different from each other and from the defaults.
# The app REFUSES to start in production with the dev-only defaults.
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-32-plus-character-random-string
JWT_SECRET=change-me-to-a-32-plus-character-random-string
OTP_HMAC_SECRET=change-me-to-a-32-plus-character-random-string

# -----------------------------------------------------------------------------
# Token / OTP settings
# -----------------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15             # Keep short — blacklist covers revocation
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_DAILY_CAP_PER_PHONE=10
PASSWORD_MIN_LENGTH=8
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# CORS / Proxy
# Comma-separated list of allowed frontend origins.
# In production set to your actual domain(s) only.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# IP ranges of trusted reverse proxies (for X-Forwarded-For). Leave empty
# unless you have a load balancer.
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# SMS — Africa's Talking (primary provider for Rwanda)
# Sign up at https://account.africastalking.com
# See backend/CREDENTIALS_GUIDE.md for step-by-step instructions.
# -----------------------------------------------------------------------------
SMS_PROVIDER=fake                        # fake | africastalking | pindo | twilio
SMS_SENDER_ID=ITSINDA
SMS_API_KEY=your_africastalking_username
SMS_API_SECRET=your_africastalking_api_key
SMS_BASE_URL=                            # Leave empty for the default AT endpoint
SMS_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Push notifications — Firebase Cloud Messaging (FCM)
# Used for Android, iOS (via FCM-to-APNS bridge), and web.
#
# Setup:
#   1. Go to https://console.firebase.google.com
#   2. Create a project named "Itsinda"
#   3. Add an Android app (package: rw.itsinda.app)
#   4. Settings → Service Accounts → Generate new private key
#   5. Paste the JSON content as a single line in FCM_SERVICE_ACCOUNT_JSON
#   6. Copy the project ID into FCM_PROJECT_ID
#
# The outbox worker uses these to deliver push notifications to mobile devices.
# Leave empty to disable push — SMS will still be sent as a fallback.
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=                          # e.g. itsinda-prod
FCM_SERVICE_ACCOUNT_JSON=               # Full JSON string from Firebase console
                                         # (single line, no line breaks)

# -----------------------------------------------------------------------------
# MTN Mobile Money
# See backend/CREDENTIALS_GUIDE.md for step-by-step registration instructions.
# Required only for real money movement. App works without it (cash mode).
# -----------------------------------------------------------------------------
MTN_ENVIRONMENT=sandbox                  # sandbox | production
MTN_COLLECTION_BASE_URL=https://sandbox.momodeveloper.mtn.com/collection
MTN_DISBURSEMENT_BASE_URL=https://sandbox.momodeveloper.mtn.com/disbursement
MTN_COLLECTION_API_USER=
MTN_COLLECTION_API_KEY=
MTN_DISBURSEMENT_API_USER=
MTN_DISBURSEMENT_API_KEY=
MTN_WEBHOOK_SECRET=                      # Shared secret for webhook signature verification
MTN_CALLBACK_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Email — Resend (recommended) or SMTP
# See backend/CREDENTIALS_GUIDE.md for Resend setup instructions.
# Used only for: email verification links, optional monthly statements.
# Leave provider=fake for local development — emails are logged, not sent.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=fake                      # fake | smtp | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@itsinda.rw
RESEND_API_KEY=                          # re_xxxxxxxxxxxxxxxx
EMAIL_FROM=no-reply@itsinda.rw
PUBLIC_BASE_URL=http://localhost:8000    # Used in email verification links

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=1
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_OTP_PER_MINUTE=5
RATE_LIMIT_OTP_PER_HOUR=20

# -----------------------------------------------------------------------------
# Ibimina business rules
# These control default behaviour that group presidents can override per group.
# -----------------------------------------------------------------------------
# Days after contribution_day before a penalty can be charged (grace period)
PENALTY_GRACE_DAYS=3
# Default late-payment penalty as % of missed contribution (e.g. 10.0 = 10%)
DEFAULT_PENALTY_PCT=10.0
# Max active loans per member per group
MAX_ACTIVE_LOANS_PER_MEMBER=1
# Min months of membership before a loan can be requested (0 = no minimum)
LOAN_MIN_MEMBERSHIP_MONTHS=0
# Allow loan requests when pot is insufficient (true = request queued, false = rejected)
ALLOW_UNDERFUNDED_LOAN_REQUESTS=true

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=1                               # 0 for human-readable logs in development
SENTRY_DSN=                              # Leave empty to disable Sentry

# -----------------------------------------------------------------------------
# Platform
# -----------------------------------------------------------------------------
PRIVACY_NOTICE_VERSION=2026-11-14
IDEMPOTENCY_TTL_HOURS=24
OUTBOX_MAX_ATTEMPTS=5
EMAIL_TOKEN_TTL_MINUTES=1440            # 24 hours for email verification links
